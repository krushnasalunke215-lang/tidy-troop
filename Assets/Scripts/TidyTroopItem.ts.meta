  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TidyTroopItem – a numbered thing to put away</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float number = 1 {"hint":"Number shown on the floating tag (1 to 10)", "widget":"slider", "min":1, "max":10, "step":1}'
