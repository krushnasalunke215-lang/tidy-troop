  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">TidyTroopMain – Tidy Troop game flow</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">References</span>"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input AssignableType_1 picker {"hint":"Character picker panel"}'
    - '// @input AssignableType_2 tags {"hint":"Floating number tags"}'
    - '// @input AssignableType_3 bubble {"hint":"Character speech bubble"}'
    - '// @input AssignableType_4 arrow {"hint":"Out-of-view arrow"}'
    - '// @input AssignableType_5 audio {"hint":"Sound cues"}'
    - '// @input AssignableType_6 celebration {"hint":"Ending light wave + sparkles"}'
    - '// @input AssignableType_7 sergeant {"hint":"Character 1: Sergeant Sweep"}'
    - '// @input AssignableType_8 captain {"hint":"Character 2: Captain Fresh"}'
    - '// @input SceneObject room {"hint":"Room root: every TidyTroopItem and TidyTroopSlot under it takes part"}'
    - "// @input SceneObject floorCenter {\"hint\":\"A point on the room floor: its height is the floor for the ending light wave, and the final salute happens here if 'Final salute on item' is 0\"}"
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Settings</span>"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input string placementMode = "ColorfulHomeBedroom" {"hint":"Where the room goes. Colorful Home bedroom: the mess sits on the bed and floor of the Colorful Home preview bedroom (fixed world spots = the Scene transforms under Room; the virtual bed hides). Around the user: the whole stand-in room, virtual bed included, is placed around wherever the user starts, facing their start heading", "widget":"combobox", "values":[{"label":"Colorful Home bedroom (fixed)", "value":"ColorfulHomeBedroom"}, {"label":"Around the user (any room)", "value":"AroundUser"}]}'
    - '// @input float eyeHeightCm = 136 {"hint":"Around the user mode only: eye height of the user, cm. The room floor is placed this far below the eyes at start (136 matches the Colorful Home preview)", "widget":"slider", "min":100, "max":200, "step":1}'
    - '// @input float snapRadiusCm = 32 {"hint":"How close (cm) a released item must be to its place to snap in. A drop over the furniture that holds the place (cupboard, bookshelf, rack) also counts", "widget":"slider", "min":10, "max":60, "step":1}'
    - '// @input float saluteSeconds = 3 {"hint":"Seconds the character stays after each item", "widget":"slider", "min":1, "max":6, "step":0.1}'
    - '// @input float endingSeconds = 6 {"hint":"Seconds the ending stays before it fades", "widget":"slider", "min":3, "max":12, "step":0.5}'
    - '// @input vec2 viewConeDeg = {30,65} {"hint":"Out-of-view hint: view cone half-angles in degrees (horizontal, vertical). Vertical is wide because people look down at the bed and desk"}'
    - '// @input string praiseText = "You are disciplined!" {"hint":"Second line of the bubble after each item (the count is added). The first line names the job and depends on the buddy (TidyTroopLines.ts)"}'
    - '// @input string finaleText = "Room fresh!" {"hint":"What the character says at the end (the count is added; the time taken goes on the second line)"}'
    - '// @input vec2 saluteViewConeDeg = {16,18} {"hint":"Salute view cone half-angles in degrees (horizontal, vertical): the salute starts once the cleared spot is inside it. 16 x 18 is about the SPECS display"}'
    - '// @input float saluteWaitSeconds = 8 {"hint":"Longest wait (s) for you to look at the cleared spot; after this the salute plays anyway", "widget":"slider", "min":1, "max":20, "step":0.5}'
    - '// @input float briefingSeconds = 3.5 {"hint":"Seconds the buddy explains where to start, right after the pick", "widget":"slider", "min":0, "max":8, "step":0.5}'
    - "// @input string bedItemNumbers = \"1,2,3\" {\"hint\":\"Item numbers that lie on the bed, comma separated. Putting the last of them away gets 'Bed clear!' and sparkles\"}"
    - '// @input float finaleOnItem = 1 {"hint":"The final salute happens on the spot where this item lay (1 = the shirt on the bed). 0 = at FloorCenter", "widget":"slider", "min":0, "max":10, "step":1}'
    - '// @input float finaleWaitSeconds = 10 {"hint":"Longest wait (s) for you to turn to the final salute spot; after this the ending plays anyway", "widget":"slider", "min":2, "max":30, "step":0.5}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">Debug</span>"}'
    - '// @ui {"widget":"group_start", "label":"Debug"}'
    - '// @input bool debugColliders {"hint":"Draw every collider in the room as a wireframe (takes effect on preview restart)"}'
    - '// @ui {"widget":"group_end"}'
